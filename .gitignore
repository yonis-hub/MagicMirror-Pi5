# Dependencies
node_modules/
package-lock.json

# Reciter audio packs (too large for GitHub — transfer to Pi via scp/rsync)
quran_data/_reciters/

# Per-surah verse-duration cache written by quran_chainer.py (regenerable).
quran_data/*/durations.*.json

# Harvested recitation audio — 1.59 GB across 6,236 files, and the whole reason
# this repo was 1.6 GB. Regenerable: quran_harvester.py pulls it from
# cdn.islamic.network. The per-verse JSON beside it stays tracked (3.7 MB for
# all 6,237 files), so a fresh clone still has every verse's Arabic and
# translation and only needs the audio harvested.
quran_data/**/*.mp3

# (Adhkar audio is ignored in magicmirror/.gitignore instead — the negations in
# that file re-include everything under the module, and a nested .gitignore
# overrides the root for paths beneath it.)

# MagicMirror specific
magicmirror/node_modules/
magicmirror/modules/*/node_modules/
magicmirror/fonts/node_modules/
magicmirror/vendor/node_modules/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Logs
*.log
npm-debug.log*

# Cache
.cache/
.pytest_cache/
__pycache__/
*.pyc

# Environment
.env
.env.local

# Python virtual environments
venv/
.venv/
**/venv/
**/.venv/

# Temporary files
*.tmp
*.temp

# Local diagnostics/artifacts
mic_test.wav
voice_listener.log
magicmirror/modules/MMM-QuranDisplay/logs/
.claude/
